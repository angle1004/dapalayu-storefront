# 절대 실제 값을 Git에 커밋하지 마세요.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.<id>.mongodb.net/dapalayu?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=https://dapalayu.com,https://www.dapalayu.com
# 쉼표로 구분한 운영자 이메일. 회원가입 시 이 목록의 계정이 admin 권한을 받습니다.
ADMIN_EMAILS=owner@example.com
PORT=10000
